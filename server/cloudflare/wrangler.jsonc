// Royal Club room server on Cloudflare (see worker.mjs). Deployed by .github/workflows/rooms-cloudflare.yml.
// Address: wss://royal-club-rooms.<your-account>.workers.dev (the deploy log prints it).
{
  "name": "royal-club-rooms",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  // The game files use Node's crypto, Buffer and process.env.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Rooms" }]
  },
  // The free Workers plan needs SQLite-backed Durable Objects (the rooms themselves stay in memory).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Rooms"] }],
  "observability": { "enabled": true }
}
